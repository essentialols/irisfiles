{
  "name": "irisfiles",
  "version": "1.0.0",
  "description": "Privacy-first browser file converter for images, video, audio, PDFs, documents, fonts, archives, and metadata. No uploads.",
  "private": true,
  "scripts": {
    "build": "bash build.sh",
    "dev": "npx serve . -p 3000",
    "start": "npx serve . -p 3000",
    "test": "node test/validate.mjs && node test/seo-treatment.mjs",
    "test:e2e": "npx playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "esbuild": "^0.24.0",
    "fflate": "^0.8.2",
    "gifenc": "^1.0.3",
    "heic-to": "^1.4.2",
    "jspdf": "^4.2.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.624",
    "serve": "^14.2.0"
  },
  "keywords": [
    "file-converter",
    "image-converter",
    "audio-converter",
    "video-converter",
    "pdf-tools",
    "heic",
    "ffmpeg",
    "webassembly",
    "privacy",
    "client-side",
    "browser"
  ],
  "license": "MIT"
}
